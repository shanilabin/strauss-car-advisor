# Copy to web/.env.local and fill in. Never commit .env.local.
# In the cloud, the same names go into Vercel -> strauss-web -> Settings -> Environment Variables.

# Where Next.js forwards /api/* (local FastAPI, or the strauss-api Vercel URL)
API_URL=http://127.0.0.1:8000

# Supabase - publishable values only (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
