# Copy to api/.env.local and fill in. Never commit .env.local.
# In the cloud, the same names go into Vercel -> strauss-api -> Settings -> Environment Variables.

ENVIRONMENT=local

# Supabase (Project Settings -> API Keys). The secret key is server-only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# LLM providers (free tiers). Each developer uses her own Gemini key locally.
GEMINI_API_KEY=
# Optional: a key from another Google project, only for reading payslips (keeps the chat's quota)
PAYSLIP_GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Model fallback chain, first to last: provider:model, comma separated. A provider without a key is skipped.
# Model chain, first to last: provider:model, comma separated. A provider without a key is skipped.
# Gemini's free quota is per model (about 20 requests a day), so several are chained before Groq.
# Leave it out to use the default in strauss/settings.py.
# LLM_CHAIN=google:gemini-3.6-flash,google:gemini-3.8-flash,google:gemini-3.5-flash,google:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,groq:llama-3.3-70b-versatile,groq:meta-llama/llama-4-scout-17b-16e-instruct,openrouter:meta-llama/llama-3.3-70b-instruct:free
